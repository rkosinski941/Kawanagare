{
  "name": "kawanagare",
  "version": "0.1.0-m1",
  "description": "KawaNagare: streams, moves and seeds on git",
  "type": "module",
  "bin": {
    "kawa": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
